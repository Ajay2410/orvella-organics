rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "gondaliyakishan1386@gmail.com";
    }

    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
